# Managed Postgres (Neon): use pooled endpoint for DATABASE_URL and direct endpoint for DATABASE_URL_UNPOOLED
DATABASE_URL="postgresql://user:pass@ep-name-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-name.region.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="change-me-in-production-at-least-32-chars"
PORT=3000
